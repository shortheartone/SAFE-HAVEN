# ============================================================
#  SAFE-HAVEN — Frontend Environment Variables
#  Copy this file to .env and fill in your values.
# ============================================================

# The Soroban smart contract ID that the frontend will interact with.
# This is the base64-encoded contract ID returned by `stellar contract deploy`.
# You must deploy the contract to your target network first, then paste the
# resulting ID here. Find it in the deploy command output or by querying
# the network via `stellar contract list`.
VITE_CONTRACT_ID=CAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAABSC4

# The Stellar network passphrase identifies which network (testnet or mainnet)
# the app connects to. Using the wrong passphrase will cause all transactions
# to fail silently or target the wrong network.
# Testnet passphrase: "Test SDF Network ; September 2015"
# Mainnet passphrase: "Public Global Stellar Network ; September 2015"
# Full list of network passphrases and documentation:
#   https://developers.stellar.org/docs/learn/basics/network-passphrases/
VITE_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"

# The Soroban RPC endpoint URL used to submit transactions and query ledger
# state. You must choose the URL that matches your target network (testnet or
# mainnet). Using the wrong URL will result in failed or misdirected requests.
# Testnet: https://soroban-testnet.stellar.org
# Mainnet: https://soroban.stellar.org
# Soroban RPC documentation:
#   https://developers.stellar.org/docs/soroban/getting-started/rpc/
VITE_RPC_URL=https://soroban-testnet.stellar.org

# The Horizon REST API endpoint used for account lookups, transaction
# history, and balance queries. Horizon is the Stellar network API layer.
# Testnet: https://horizon-testnet.stellar.org
# Mainnet: https://horizon.stellar.org
# Horizon API documentation:
#   https://developers.stellar.org/docs/data/horizon/
VITE_HORIZON_URL=https://horizon-testnet.stellar.org

# The Stellar Expert explorer base URL. Used to generate clickable links to
# the blockchain explorer so users and developers can inspect transactions,
# accounts, and contracts on the chosen network.
# Testnet: https://stellar.expert/explorer/testnet
# Mainnet: https://stellar.expert/explorer
VITE_EXPLORER_URL=https://stellar.expert/explorer/testnet

# (Optional) Source account used for read-only simulations when no wallet is
# connected. Defaults to the contract ID if unset. Set this to a funded
# account on your target network to avoid synthetic-account fallback behavior.
# On testnet, you can fund an account via https://friendbot.stellar.org/.
# On mainnet, set this to any existing funded account.
# Example: GAAAAAAAA...
# VITE_SIMULATION_ACCOUNT=

# ============================================================
#  Fiat On-Ramp Configuration (Ramp Network)
# ============================================================

# Ramp Network API key for the embedded widget. Get yours at:
#   https://ramp.network/
# Testnet/staging key should use `rampnetwork` as the API key for testing.
# Leave unset to disable the "Buy Tokens" feature.
# VITE_RAMP_API_KEY=rampnetwork

# Ramp Network environment. Options: "production" or "staging"
# Default: "staging" (for testing without KYC delays)
# VITE_RAMP_ENVIRONMENT=staging

# ============================================================
#  Version Pinning (#399)
# ============================================================

# Expected contract version this frontend build targets (semver, e.g. "0.1.0").
# When set, the app will display a warning or error banner if the live contract
# reports a different version. Defaults to "0.1.0" if unset.
# VITE_EXPECTED_CONTRACT_VERSION=0.1.0

# Expected storage schema version (integer).
# A mismatch here is treated as an error because the on-chain data layout
# may have changed and the frontend may be unable to read existing deposits.
# Defaults to 1 if unset.
# VITE_EXPECTED_STORAGE_VERSION=1